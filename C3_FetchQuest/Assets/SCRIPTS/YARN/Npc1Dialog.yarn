title: loadPhase
position: -86,-332
color: yellow
---
<<declare $dialogPhase = "">>
<<declare $hasVisited = false>> //has player talked to this npc at least once?
<<setPhase NPC>>
<<if $dialogPhase == "begin">>
<<jump start>>
<<elseif $dialogPhase == "comeback">>
//<<jump comeback>>
<<jump comebackNode>>
<<elseif $dialogPhase == "quest_started">>
//<<jump node3>>
<<jump acceptQuestNode>>
<<elseif $dialogPhase == "quest_completed">>
//<<jump  doneWithQuest>>
<<jump questCompleteNode>>
<<endif>>
===
