title: loadPhase
position: -86,-332
color: yellow
---
<<declare $dialogPhase = "">>
<<declare $finished = false>>
<<declare $itemNeeded = "apple">>
<<declare $hasVisited = false>> //has player talked to this npc at least once?
<<declare $acceptedQuest = false>>
<<setPhase NPC>>
<<if $dialogPhase == "begin">>
<<set $hasVisited to true>>
<<jump start>>
<<elseif $dialogPhase == "comeback">>
//<<jump comeback>>
<<jump comebackNode>>
<<elseif $dialogPhase == "quest_started">>
//<<jump node3>>
<<jump acceptQuestNode>>
<<elseif $dialogPhase == "quest_completed">>
//<<jump  doneWithQuest>>
<<jump questCompleteNode>>
<<else>>
<<endif>>
===
